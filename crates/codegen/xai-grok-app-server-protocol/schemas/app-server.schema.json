{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grok-oss.local/schemas/app-server.2026-07-18.experimental-v2.json",
  "title": "grok-oss App Server experimental-v2",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" },
    { "$ref": "#/$defs/notification" }
  ],
  "$defs": {
    "requestId": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 128 }, { "type": "integer" }] },
    "request": { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/requestId" }, "method": { "type": "string", "minLength": 1, "maxLength": 128 }, "params": { "type": "object" } } },
    "success": { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "result"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "$ref": "#/$defs/requestId" }, "result": {} } },
    "failure": { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "id", "error"], "properties": { "jsonrpc": { "const": "2.0" }, "id": { "oneOf": [{ "$ref": "#/$defs/requestId" }, { "type": "null" }] }, "error": { "$ref": "#/$defs/rpcError" } } },
    "notification": { "type": "object", "additionalProperties": false, "required": ["jsonrpc", "method", "params"], "properties": { "jsonrpc": { "const": "2.0" }, "method": { "type": "string", "minLength": 1, "maxLength": 128 }, "params": { "type": "object" } } },
    "rpcError": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "integer" }, "message": { "type": "string", "maxLength": 1024 }, "data": { "type": "object", "properties": { "code": { "type": "string" }, "retryable": { "type": "boolean" }, "operationId": { "type": "string" } } } } },
    "wireCounter": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$", "description": "Canonical unsigned u64 decimal string; JSON numbers are forbidden to preserve JavaScript precision." },
    "providerBinding": { "type": "object", "additionalProperties": false, "required": ["providerId", "credentialId", "modelId", "backend", "bindingRevision"], "properties": { "providerId": { "type": "string", "minLength": 1, "maxLength": 128 }, "credentialId": { "type": "string", "minLength": 1, "maxLength": 128 }, "modelId": { "type": "string", "minLength": 1, "maxLength": 256 }, "backend": { "type": "string", "minLength": 1, "maxLength": 64 }, "bindingRevision": { "$ref": "#/$defs/wireCounter" } }, "description": "Immutable public identifiers only; credential material is forbidden." },

    "clientCapabilities": { "type": "object", "additionalProperties": false, "required": ["interactions", "reconnect", "experimental"], "properties": { "interactions": { "type": "boolean" }, "reconnect": { "type": "boolean" }, "experimental": { "type": "array", "maxItems": 64, "items": { "type": "string", "maxLength": 128 } } } },
    "serverCapabilities": { "type": "object", "additionalProperties": false, "required": ["sessions", "turns", "items", "interactions", "experimental"], "properties": { "sessions": { "type": "object", "additionalProperties": false, "required": ["list", "read", "start", "resume", "fork", "archive", "subscribe"], "properties": { "list": { "type": "boolean" }, "read": { "type": "boolean" }, "start": { "type": "boolean" }, "resume": { "type": "boolean" }, "fork": { "type": "boolean" }, "archive": { "type": "boolean" }, "subscribe": { "type": "boolean" } } }, "turns": { "type": "object", "additionalProperties": false, "required": ["start", "steer", "interrupt"], "properties": { "start": { "type": "boolean" }, "steer": { "type": "boolean" }, "interrupt": { "type": "boolean" } } }, "items": { "type": "object", "additionalProperties": false, "required": ["lifecycle", "deltas"], "properties": { "lifecycle": { "type": "boolean" }, "deltas": { "type": "boolean" } } }, "interactions": { "type": "object", "additionalProperties": false, "required": ["approvals", "questions", "mcpElicitation"], "properties": { "approvals": { "type": "boolean" }, "questions": { "type": "boolean" }, "mcpElicitation": { "type": "boolean" } } }, "experimental": { "type": "array", "items": { "type": "string" } } } },
    "protocolLimits": { "type": "object", "additionalProperties": false, "required": ["maxMessageBytes", "maxPageSize", "replayWindowEvents", "outboundQueueEvents", "initializeTimeoutMs"], "properties": { "maxMessageBytes": { "const": 1048576 }, "maxPageSize": { "const": 100 }, "replayWindowEvents": { "const": 10000 }, "outboundQueueEvents": { "const": 1024 }, "initializeTimeoutMs": { "const": 10000 } } },
    "initializeParams": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "clientInfo", "capabilities"], "properties": { "protocolVersion": { "const": "2026-07-18.experimental-v2" }, "clientInfo": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 128 }, "version": { "type": "string", "minLength": 1, "maxLength": 64 } } }, "capabilities": { "$ref": "#/$defs/clientCapabilities" } } },
    "initializeResult": { "type": "object", "additionalProperties": false, "required": ["protocolVersion", "serverInfo", "serverInstanceId", "capabilities", "limits"], "properties": { "protocolVersion": { "const": "2026-07-18.experimental-v2" }, "serverInfo": { "type": "object", "required": ["name", "version"], "properties": { "name": { "const": "grok-oss" }, "version": { "type": "string" } } }, "serverInstanceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }, "capabilities": { "$ref": "#/$defs/serverCapabilities" }, "limits": { "$ref": "#/$defs/protocolLimits" } } },

    "session": { "type": "object", "additionalProperties": false, "required": ["sessionId", "historyEpoch", "revision", "status", "workspaceRoot", "createdAtMs", "updatedAtMs", "title", "activeTurnId", "latestTurnId", "providerBinding"], "properties": { "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }, "historyEpoch": { "type": "string", "minLength": 1, "maxLength": 128 }, "revision": { "$ref": "#/$defs/wireCounter" }, "status": { "enum": ["starting", "ready", "running", "waiting_for_input", "dormant", "completed", "failed", "archived"] }, "workspaceRoot": { "type": "string", "minLength": 1, "maxLength": 4096 }, "title": { "type": ["string", "null"], "maxLength": 512 }, "activeTurnId": { "type": ["string", "null"], "maxLength": 128 }, "latestTurnId": { "type": ["string", "null"], "maxLength": 128 }, "providerBinding": { "oneOf": [{ "$ref": "#/$defs/providerBinding" }, { "type": "null" }] }, "createdAtMs": { "type": "integer", "minimum": 0 }, "updatedAtMs": { "type": "integer", "minimum": 0 } } },
    "turn": { "type": "object", "additionalProperties": false, "required": ["turnId", "sessionId", "providerBinding", "ordinal", "kind", "status", "revision", "createdAtMs", "completedAtMs"], "properties": { "turnId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }, "providerBinding": { "oneOf": [{ "$ref": "#/$defs/providerBinding" }, { "type": "null" }] }, "ordinal": { "type": "integer", "minimum": 1 }, "kind": { "enum": ["user", "steer", "resume", "synthetic"] }, "status": { "enum": ["queued", "in_progress", "waiting_for_approval", "waiting_for_input", "completed", "failed", "interrupted", "declined"] }, "revision": { "$ref": "#/$defs/wireCounter" }, "createdAtMs": { "type": "integer", "minimum": 0 }, "completedAtMs": { "type": ["integer", "null"], "minimum": 0 } } },
    "itemBase": { "type": "object", "required": ["itemId", "sessionId", "turnId", "type", "status", "revision", "eventSeq", "createdAtMs"], "properties": { "itemId": { "type": "string", "minLength": 1, "maxLength": 128 }, "sessionId": { "type": "string", "minLength": 1, "maxLength": 128 }, "turnId": { "type": "string", "minLength": 1, "maxLength": 128 }, "status": { "enum": ["pending", "in_progress", "waiting_for_approval", "waiting_for_input", "completed", "failed", "declined", "cancelled", "backgrounded"] }, "revision": { "$ref": "#/$defs/wireCounter" }, "eventSeq": { "$ref": "#/$defs/wireCounter" }, "createdAtMs": { "type": "integer", "minimum": 0 } } },
    "item": { "allOf": [{ "$ref": "#/$defs/itemBase" }, { "oneOf": [
      { "type": "object", "required": ["type", "content"], "properties": { "type": { "const": "user_message" }, "content": { "type": "array", "minItems": 1, "items": { "type": "object" } } } },
      { "type": "object", "required": ["type", "text"], "properties": { "type": { "const": "agent_message" }, "text": { "type": "string", "maxLength": 1048576 } } },
      { "type": "object", "required": ["type", "toolName", "arguments"], "properties": { "type": { "const": "tool_call" }, "toolName": { "type": "string" }, "arguments": {} } },
      { "type": "object", "required": ["type", "toolName", "output", "isError"], "properties": { "type": { "const": "tool_result" }, "toolName": { "type": "string" }, "output": {}, "isError": { "type": "boolean" } } },
      { "type": "object", "required": ["type", "command", "argv", "cwd"], "properties": { "type": { "const": "command_execution" }, "command": { "type": "string" }, "argv": { "type": "array", "items": { "type": "string" } }, "cwd": { "type": "string" } } },
      { "type": "object", "required": ["type", "changes"], "properties": { "type": { "const": "file_change" }, "changes": { "type": "array", "items": { "type": "object" } } } },
      { "type": "object", "required": ["type", "content", "steps"], "properties": { "type": { "const": "plan" }, "content": { "type": "string" }, "steps": { "type": "array", "items": { "type": "object" } } } },
      { "type": "object", "required": ["type", "subagentId", "agentType", "description"], "properties": { "type": { "const": "subagent" }, "subagentId": { "type": "string" }, "agentType": { "type": "string" }, "description": { "type": "string" } } },
      { "type": "object", "required": ["type", "server", "toolName", "arguments"], "properties": { "type": { "const": "mcp_tool_call" }, "server": { "type": "string" }, "toolName": { "type": "string" }, "arguments": {} } },
      { "type": "object", "required": ["type", "summary"], "properties": { "type": { "const": "reasoning_summary" }, "summary": { "type": "string" } } },
      { "type": "object", "required": ["type", "hookName", "phase", "safeSummary"], "properties": { "type": { "const": "hook" }, "hookName": { "type": "string" }, "phase": { "type": "string" }, "safeSummary": { "type": "string" } } },
      { "type": "object", "required": ["type", "taskId", "safeSummary"], "properties": { "type": { "const": "background_task" }, "taskId": { "type": "string" }, "safeSummary": { "type": "string" } } },
      { "type": "object", "required": ["type", "safeSummary"], "properties": { "type": { "const": "compaction" }, "safeSummary": { "type": "string" } } },
      { "type": "object", "required": ["type", "providerId", "code", "safeMessage"], "properties": { "type": { "const": "provider_error" }, "providerId": { "type": "string" }, "code": { "type": "string" }, "safeMessage": { "type": "string" } } },
      { "type": "object", "required": ["type", "code", "message"], "properties": { "type": { "const": "error" }, "code": { "type": "string" }, "message": { "type": "string" } } },
      { "type": "object", "required": ["type", "interactionId", "prompt", "choices"], "properties": { "type": { "const": "interaction_request" }, "interactionId": { "type": "string" }, "prompt": { "type": "string" }, "choices": { "type": "array", "items": { "type": "string" } } } },
      { "type": "object", "required": ["type", "extensionType", "payload"], "properties": { "type": { "const": "extension" }, "extensionType": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" }, "payload": {} } }
    ] }] },

    "idempotencyKey": { "type": "string", "minLength": 8, "maxLength": 128 },
    "sessionStartParams": { "type": "object", "additionalProperties": false, "required": ["workspaceRoot", "idempotencyKey"], "properties": { "workspaceRoot": { "type": "string", "minLength": 1, "maxLength": 4096 }, "agentType": { "type": ["string", "null"], "maxLength": 128 }, "providerBinding": { "oneOf": [{ "$ref": "#/$defs/providerBinding" }, { "type": "null" }] }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "sessionReadParams": { "type": "object", "additionalProperties": false, "required": ["sessionId"], "properties": { "sessionId": { "type": "string" }, "includeTurns": { "type": "boolean", "default": false }, "includeItems": { "type": "boolean", "default": false } } },
    "sessionListParams": { "type": "object", "additionalProperties": false, "properties": { "pageSize": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }, "cursor": { "type": ["string", "null"] }, "includeArchived": { "type": "boolean", "default": false }, "workspaceRoot": { "type": ["string", "null"] } } },
    "sessionTargetMutation": { "type": "object", "additionalProperties": false, "required": ["sessionId", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "sessionForkParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "workspaceRoot": { "type": ["string", "null"] }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "subscribeParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "afterEventSeq"], "properties": { "sessionId": { "type": "string" }, "historyEpoch": { "type": ["string", "null"] }, "afterEventSeq": { "$ref": "#/$defs/wireCounter" } } },
    "turnStartParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "input", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "input": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "type": "object" } }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "turnSteerParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "turnId", "input", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "turnId": { "type": "string" }, "input": { "type": "array", "minItems": 1, "items": { "type": "object" } }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "turnInterruptParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "turnId", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "turnId": { "type": "string" }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "interactionRespondParams": { "type": "object", "additionalProperties": false, "required": ["sessionId", "turnId", "interactionId", "decision", "idempotencyKey"], "properties": { "sessionId": { "type": "string" }, "turnId": { "type": "string" }, "interactionId": { "type": "string" }, "decision": { "enum": ["accept", "accept_for_turn", "accept_for_session", "decline", "cancel"] }, "idempotencyKey": { "$ref": "#/$defs/idempotencyKey" } } },
    "operationResult": { "type": "object", "additionalProperties": false, "required": ["operationId", "accepted"], "properties": { "operationId": { "type": "string" }, "accepted": { "type": "boolean" } } },
    "eventMeta": { "type": "object", "required": ["sessionId", "historyEpoch", "eventSeq", "timestampMs"], "properties": { "subscriptionId": { "type": "string", "minLength": 1 }, "sessionId": { "type": "string" }, "historyEpoch": { "type": "string" }, "eventSeq": { "$ref": "#/$defs/wireCounter" }, "timestampMs": { "type": "integer", "minimum": 0 } } },
    "itemDeltaParams": { "allOf": [{ "$ref": "#/$defs/eventMeta" }, { "type": "object", "required": ["turnId", "itemId", "revision", "delta", "stream"], "properties": { "turnId": { "type": "string" }, "itemId": { "type": "string" }, "revision": { "$ref": "#/$defs/wireCounter" }, "delta": { "type": "string" }, "stream": { "enum": ["content", "stdout", "stderr", "reasoning_summary"] } } }] },
    "interactionRequest": { "type": "object", "additionalProperties": false, "required": ["interactionId", "sessionId", "turnId", "itemId", "kind", "prompt", "choices", "expiresAtMs"], "properties": { "interactionId": { "type": "string" }, "sessionId": { "type": "string" }, "turnId": { "type": "string" }, "itemId": { "type": "string" }, "kind": { "enum": ["approval", "question", "mcp_elicitation"] }, "prompt": { "type": "string", "maxLength": 65536 }, "choices": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 1024 } }, "expiresAtMs": { "type": ["integer", "null"] } } },
    "sessionResult": { "type": "object", "additionalProperties": false, "required": ["session"], "properties": { "session": { "$ref": "#/$defs/session" } } },
    "turnResult": { "type": "object", "additionalProperties": false, "required": ["turn"], "properties": { "turn": { "$ref": "#/$defs/turn" } } },
    "itemResult": { "type": "object", "additionalProperties": false, "required": ["item"], "properties": { "item": { "$ref": "#/$defs/item" } } },
    "sessionListResult": { "type": "object", "additionalProperties": false, "required": ["sessions", "nextCursor"], "properties": { "sessions": { "type": "array", "items": { "$ref": "#/$defs/session" } }, "nextCursor": { "type": ["string", "null"] } } },
    "sessionReadResult": { "type": "object", "additionalProperties": false, "required": ["session", "turns", "items"], "properties": { "session": { "$ref": "#/$defs/session" }, "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } }, "items": { "type": "array", "items": { "$ref": "#/$defs/item" } } } },
    "subscribeResult": { "type": "object", "additionalProperties": false, "required": ["subscriptionId", "historyEpoch", "replayedThroughEventSeq", "liveFromEventSeq"], "properties": { "subscriptionId": { "type": "string" }, "historyEpoch": { "type": "string" }, "replayedThroughEventSeq": { "$ref": "#/$defs/wireCounter" }, "liveFromEventSeq": { "$ref": "#/$defs/wireCounter" } } },
    "sessionEvent": { "allOf": [{ "$ref": "#/$defs/eventMeta" }, { "type": "object", "required": ["session"], "properties": { "session": { "$ref": "#/$defs/session" } } }] },
    "turnEvent": { "allOf": [{ "$ref": "#/$defs/eventMeta" }, { "type": "object", "required": ["turn"], "properties": { "turn": { "$ref": "#/$defs/turn" } } }] },
    "itemEvent": { "allOf": [{ "$ref": "#/$defs/eventMeta" }, { "type": "object", "required": ["item"], "properties": { "item": { "$ref": "#/$defs/item" } } }] }
  }
}
